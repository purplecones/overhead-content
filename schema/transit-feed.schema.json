{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/purplecones/overhead-content/main/schema/transit-feed.schema.json",
  "title": "Transit feed record",
  "description": "Structural check for content/transit-feeds/<id>/record.json, mirroring lib/transit/record.js in the Overhead repository. That validator is authoritative and is what the Worker, the pack build, npm run transit:try, and the tests all run; a record that passes this schema can still be rejected there. This schema cannot express: id must equal its directory name; coverage.minLat < coverage.maxLat and coverage.minLon < coverage.maxLon, with a span of at most 10 degrees each way; a gps record needs at least one realtime.vehiclePositions URL, and a predicted record needs at least one realtime.tripUpdates URL; a key names exactly one of query or header; a key.secret must actually exist as a Worker secret to be usable; and text fields reject a value that is only whitespace.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "id", "agency", "coverage", "modes", "positioning", "realtime", "static", "licence", "provenance"],
  "properties": {
    "kind": { "const": "transit-feed" },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 24
    },
    "agency": { "$ref": "#/$defs/text" },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minLat", "minLon", "maxLat", "maxLon"],
      "properties": {
        "minLat": { "type": "number", "minimum": -90, "maximum": 90 },
        "maxLat": { "type": "number", "minimum": -90, "maximum": 90 },
        "minLon": { "type": "number", "minimum": -180, "maximum": 180 },
        "maxLon": { "type": "number", "minimum": -180, "maximum": 180 }
      }
    },
    "modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["bus", "subway", "light-rail", "rail", "ferry", "cable"] }
    },
    "positioning": { "enum": ["gps", "predicted"] },
    "realtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["refreshSeconds"],
      "properties": {
        "vehiclePositions": { "$ref": "#/$defs/urlList" },
        "tripUpdates": { "$ref": "#/$defs/urlList" },
        "refreshSeconds": { "type": "integer", "minimum": 5, "maximum": 300 },
        "key": { "$ref": "#/$defs/key" }
      }
    },
    "static": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gtfs"],
      "properties": {
        "gtfs": { "$ref": "#/$defs/urlList", "minItems": 1 },
        "key": { "$ref": "#/$defs/key" }
      }
    },
    "licence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "credit"],
      "properties": {
        "name": { "$ref": "#/$defs/text" },
        "url": { "type": "string", "format": "uri", "minLength": 1, "maxLength": 200 },
        "credit": { "$ref": "#/$defs/text" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verifiedAt"],
      "properties": {
        "verifiedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "notes": { "type": "string" }
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "urlList": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "format": "uri",
        "pattern": "^https?://"
      }
    },
    "key": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["secret"],
          "properties": {
            "secret": {
              "type": "string",
              "pattern": "^TRANSIT_KEY_[A-Z0-9_]{1,52}$"
            },
            "query": { "$ref": "#/$defs/text" },
            "header": { "$ref": "#/$defs/text" }
          }
        }
      ]
    }
  }
}
