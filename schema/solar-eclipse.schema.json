{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/purplecones/overhead-content/main/schema/solar-eclipse.schema.json",
  "title": "Solar eclipse record",
  "description": "content/events/solar-eclipses/<id>/record.json. The repository decides which eclipses the app lists; the app computes every drawn time and position itself and admits a record only if its own eclipse lands within 10 minutes of `greatest` with a matching type. docs/events.md is the field reference.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "id", "greatest", "type", "provenance"],
  "properties": {
    "kind": { "const": "solar-eclipse" },
    "id": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "greatest": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "type": { "enum": ["total", "annular", "hybrid"] },
    "title": { "type": "string", "pattern": "\\S", "maxLength": 80 },
    "summary": { "type": "string", "pattern": "\\S", "maxLength": 300 },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "url", "attribution"],
      "properties": {
        "source": { "type": "string", "pattern": "\\S" },
        "url": { "type": "string", "pattern": "^https?://" },
        "attribution": { "type": "string", "pattern": "\\S" }
      }
    }
  }
}
